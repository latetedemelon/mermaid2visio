# mermaid2visio — runtime configuration.
# Copy this file to `.env` next to docker-compose.yml and edit. docker compose
# reads .env automatically; values can also be passed inline:
#   HOST_PORT=8080 docker compose up -d

# Port published on the host. Change this when 3333 is taken on the target.
# Examples:  3333 (default) | 8080 | 18080
HOST_PORT=3333

# Port the container binds to internally. Usually fine to leave at 3333;
# only change if you need a specific internal port (e.g. behind a sidecar).
PORT=3333

# Shared-memory size for Chromium (Puppeteer headless). 512m is plenty for
# low-volume use; bump to 1g for heavier traffic or big diagrams.
SHM_SIZE=512m
